# LM-Sanctuary Environment Configuration
# Copy this file to .env (handled automatically by run_local.bat / run_local.ps1 / run_local.sh / app.py)

# Active language model engine backend
RUNNER_BACKEND=opensource

# --- SERVER HOST & PORT CONFIGURATION ---
# Bind to '0.0.0.0' to allow access from localhost, LAN/Wi-Fi devices, and Tailscale.
HOST=0.0.0.0
PORT=5000

# --- LOCAL LLM BACKEND SETUP (llama-server) ---
LOCAL_SERVER_URL=http://127.0.0.1:1234/v1/chat/completions
# Leave blank to auto-select the first discovered .gguf model in models/llm/ or ~/.lmstudio/models/
LOCAL_MODEL_NAME=

# Context & Offload Settings
LOCAL_CONTEXT=12288
LOCAL_GPU_LAYERS=99
LOCAL_CACHE_TYPE_K=q8_0
LOCAL_CACHE_TYPE_V=q8_0
LOCAL_FLASH_ATTN=true
LOCAL_NO_MMAP=false

# GPU Backend: 'auto' (recommended — auto-detects nvidia, amd, or vulkan), 'nvidia', 'amd', or 'vulkan'
LOCAL_GPU_TYPE=auto

# Prefill Batching
LOCAL_BATCH_SIZE=2048
LOCAL_UBATCH_SIZE=2048
AUTO_START_LOCAL_LLM=true

# --- IMAGE GENERATION SETUP (In-Process SDXL & Optional Headless ComfyUI) ---
COMFYUI_SERVER_URL=http://127.0.0.1:8188
COMFYUI_DIR=
# Leave blank or set to a checkpoint in models/checkpoints/ (auto-discovers any .safetensors in models/checkpoints/ if not found)
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
COMFYUI_VAE=sdxl_vae.safetensors
COMFYUI_ARGS=--lowvram

# PyTorch Memory Allocation Options
PYTORCH_HIP_ALLOC_CONF=expandable_segments:True,max_split_size_mb:512
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,max_split_size_mb:512

# --- SECURITY & AUTHENTICATION SETUP (Optional LAN / Wi-Fi protection) ---
# Leave blank to run without credentials on local networks.
AUTH_USER=
AUTH_PASS=

# --- HTTPS / SSL CONFIGURATION ---
# Set USE_HTTPS=true to enable HTTPS (required by mobile browsers over LAN for microphone/voice calls).
USE_HTTPS=false
SSL_CERT=certs/cert.pem
SSL_KEY=certs/key.pem