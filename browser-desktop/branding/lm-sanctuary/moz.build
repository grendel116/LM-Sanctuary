DIRS += ["content", "locales"]

DIST_SUBDIR = "browser"
export("DIST_SUBDIR")

# Loads last (alphabetically smallest) so LM-Sanctuary defaults override firefox.js,
# and mirrors into firefox-branding.js for stock package-manifest.in packaging.
JS_PREFERENCE_FILES += [
    "pref/00-lm-sanctuary-prefs.js",
    "pref/firefox-branding.js",
]

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "windows":
    FINAL_TARGET_FILES[".."] += [
        "firefox.VisualElementsManifest.xml",
        "private_browsing.VisualElementsManifest.xml",
    ]
    FINAL_TARGET_FILES.VisualElements += [
        "PrivateBrowsing_150.png",
        "PrivateBrowsing_70.png",
        "VisualElements_150.png",
        "VisualElements_70.png",
    ]
    FINAL_TARGET_FILES.chrome.icons.default += [
        "default.ico",
        "main-window.ico",
    ]
elif CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
    FINAL_TARGET_FILES.chrome.icons.default += [
        "default128.png",
        "default16.png",
        "default32.png",
        "default48.png",
        "default64.png",
    ]
