+++ b/browser/components/BrowserGlue.sys.mjs
@@ -759,6 +759,44 @@ BrowserGlue.prototype = {
 
   // the first browser window has finished initializing
   _onFirstWindowLoaded: function BG__onFirstWindowLoaded(aWindow) {
+    try {
+      const { ActorManagerParent } = ChromeUtils.importESModule(
+        "resource://gre/modules/ActorManagerParent.sys.mjs"
+      );
+      ActorManagerParent.addJSWindowActors({
+        SanctuaryHost: {
+          parent: {
+            esModuleURI:
+              "moz-src:///browser/components/sanctuary/SanctuaryHostParent.sys.mjs",
+          },
+          child: {
+            esModuleURI:
+              "moz-src:///browser/components/sanctuary/SanctuaryHostChild.sys.mjs",
+            events: {
+              DOMWindowCreated: {},
+            },
+          },
+          allFrames: false,
+        },
+        SanctuaryAgentPage: {
+          parent: {
+            esModuleURI:
+              "moz-src:///browser/components/sanctuary/SanctuaryAgentPageParent.sys.mjs",
+          },
+          child: {
+            esModuleURI:
+              "moz-src:///browser/components/sanctuary/SanctuaryAgentPageChild.sys.mjs",
+          },
+          remoteTypes: ["web", "webIsolated", "webCOOP+COEP", "file"],
+        },
+      });
+    } catch (ex) {
+      console.error("SanctuaryHost actor registration failed:", ex);
+    }
+    ChromeUtils.importESModule(
+      "moz-src:///browser/components/sanctuary/SanctuaryWindowHost.sys.mjs"
+    ).SanctuaryWindowHost.mount(aWindow);
+
     // A channel for "remote troubleshooting" code...
     let channel = new lazy.WebChannel(
       "remote-troubleshooting",
