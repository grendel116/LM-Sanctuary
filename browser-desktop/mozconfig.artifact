# Fast front-end & chrome iteration build fragment (downloads prebuilt Gecko binaries).

ac_add_options --enable-artifact-builds
ac_add_options --with-app-name=firefox
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/objdir-sanctuary-artifact
mk_add_options AUTOCLOBBER=1
