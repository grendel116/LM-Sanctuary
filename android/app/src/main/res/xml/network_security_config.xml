<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!--
    Android XML <domain> tags reject CIDR blocks (e.g. 100.64.0.0/10, 192.168.0.0/16).
    Allow cleartext HTTP in base-config for LAN, .local, and Tailscale CGNAT companion nodes,
    while pinning public social origins to HTTPS-only below and enforcing HTTPS in JS url builders.
  -->
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
      <certificates src="user" />
    </trust-anchors>
  </base-config>

  <domain-config cleartextTrafficPermitted="false">
    <domain includeSubdomains="true">bsky.social</domain>
    <domain includeSubdomains="true">bsky.app</domain>
    <domain includeSubdomains="true">api.bsky.app</domain>
    <domain includeSubdomains="true">api.bsky.chat</domain>
    <domain includeSubdomains="true">brid.gy</domain>
    <domain includeSubdomains="true">threads.net</domain>
    <domain includeSubdomains="true">graph.threads.net</domain>
    <domain includeSubdomains="true">mastodon.social</domain>
    <domain includeSubdomains="true">pixelfed.social</domain>
  </domain-config>
</network-security-config>
