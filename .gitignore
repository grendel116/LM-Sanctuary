# Python env and cache
.venv*
ComfyUI/
ComfyUI_windows_portable*/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/

# Node / Android build artifacts
node_modules/
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/app/src/main/assets/public/
android/capacitor-cordova-android-plugins/

# Local Config (contains credentials and settings)
.env
sanctuary/.env
sanctuary/variables/project_settings.json

# Temporary files
backups/
scratch/
sanctuary/data/
social/data/
reports/
sanctuary/certs/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.tmp
.DS_Store
Thumbs.db

# Ignore all runtime and user variables except code dependencies, template examples, and default builder profile
sanctuary/variables/*
!sanctuary/variables/settings.py
!sanctuary/variables/__init__.py
!sanctuary/variables/user.md.example
!sanctuary/variables/user_profiles/
!sanctuary/variables/banned_words.json
sanctuary/variables/user_profiles/*
!sanctuary/variables/user_profiles/builder.md

# Ignore all program profiles under sanctuary/core/programs except the default Sebile program template
sanctuary/core/programs/*
!sanctuary/core/programs/sebile/
!sanctuary/core/programs/sparkle.mp3

# Ignore user-generated dynamic program sessions, databases, custom generated portraits, and memories
sanctuary/core/programs/*/sessions/
sanctuary/core/programs/*/portraits/*
!sanctuary/core/programs/sebile/portraits/profile.png
sanctuary/core/programs/*/media/
sanctuary/core/programs/*/uploads/
sanctuary/core/programs/*/databank.db
sanctuary/core/programs/*/databank.json
sanctuary/core/programs/*/journals.json
sanctuary/core/programs/*/quest_log.json
sanctuary/core/programs/*/lorebooks/
!sanctuary/core/programs/sebile/lorebooks/
!sanctuary/core/programs/sebile/lorebooks/marxist_theory.json
!sanctuary/core/programs/sebile/lorebooks/twelve_steps.json
sanctuary/core/embeddings.pkl
sanctuary/temp_uploads/

# Local model weights and binary checkpoints
*.safetensors
*.gguf
*.pt
*.pth
*.ckpt
*.onnx
sanctuary/models/*
!sanctuary/models/__init__.py
!sanctuary/models/models.py
!sanctuary/models/**/
!sanctuary/models/**/.gitkeep
# Bundled default image workflow included in git; other custom workflows stay untracked
sanctuary/models/workflows/*
!sanctuary/models/workflows/ImageWorkflow.json

# TTS Speech Model weights and synthesized audio cache
sanctuary/core/skills/speech_generation/speech_model/*.onnx
sanctuary/core/skills/speech_generation/speech_model/*.bin
sanctuary/core/skills/speech_generation/speech_cache/

# Runtime logs
sanctuary/logs/
*.log
comfy_server.log

# Local Binaries
sanctuary/utils/llama-bin/

# Comfy Engine runtime temp, IO, and custom nodes
temp/
**/temp/
sanctuary/core/comfy_engine/temp/
sanctuary/core/comfy_engine/output/
sanctuary/core/comfy_engine/input/
sanctuary/core/comfy_engine/custom_nodes/
sanctuary/core/comfy_engine/**/*.png
sanctuary/core/comfy_engine/**/*.jpg
sanctuary/core/comfy_engine/**/*.jpeg
sanctuary/core/comfy_engine/**/*.webp
sanctuary/core/comfy_engine/**/*.gif
sanctuary/core/comfy_engine/**/*.bmp
